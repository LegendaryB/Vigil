@inherits RazorSlice<ClientKeysIndexModel>

@{
    var openCreateDialogOnclick = $"vigilOpenDialog('{DashboardStyles.CreateClientKeyDialogId}')";
}
<div id="@DashboardStyles.ClientKeysPageId">
  <div class="@DashboardStyles.DashboardToolbar">
    <h2 class="@DashboardStyles.ToolbarTitle">Client Keys</h2>
    <div class="@DashboardStyles.ToolbarActions">
      <button type="button" class="@DashboardStyles.ButtonWithIcon" onclick="window.location.href='@UiRoutes.ClientKeys'">@(new HtmlString(DashboardIcons.Reset)) Reset filters</button>
      <button type="button" class="@DashboardStyles.ButtonWithIcon" onclick="@openCreateDialogOnclick">@(new HtmlString(DashboardIcons.Plus)) Create</button>
    </div>
  </div>
  @(await RenderPartialAsync<_CreateDialog, string?>(Model.ErrorEntityId is null ? Model.Error : null))
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Client</th>
          <th>
            <span class="@DashboardStyles.ThWithFilter">
              Group
              @(await RenderPartialAsync<_ColumnFilter, ColumnFilterModel>(Model.GroupFilter))
            </span>
          </th>
          <th>API Key</th>
          <th>Created</th>
          <th>Last used</th>
          <th>Expected interval</th>
          <th>Actions</th>
        </tr>
      </thead>
      @(await RenderPartialAsync<_TableBody, ClientKeyTableBodyModel>(new ClientKeyTableBodyModel(Model.ClientKeys, Model.Error, Model.ErrorEntityId)))
    </table>
  </div>
</div>
