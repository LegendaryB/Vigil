@inherits RazorSlice<ClientKeysIndexModel>

@{
    var openCreateDialogOnclick = $"vigilOpenDialog('{DashboardStyles.CreateClientKeyDialogId}')";
}
<div id="@DashboardStyles.ClientKeysPageId">
  <div class="@DashboardStyles.DashboardToolbar">
    <h2 class="@DashboardStyles.ToolbarTitle">Client Keys</h2>
    <div class="@DashboardStyles.ToolbarActions">
      <button type="button" onclick="@openCreateDialogOnclick">Create new client key</button>
    </div>
  </div>
  @(await RenderPartialAsync<_CreateDialog, string?>(Model.Error))
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Client</th>
          <th>Group</th>
          <th>API Key</th>
          <th>Created</th>
          <th>Last used</th>
          <th>Actions</th>
        </tr>
      </thead>
      @(await RenderPartialAsync<_TableBody, IReadOnlyList<ClientKey>>(Model.ClientKeys))
    </table>
  </div>
</div>
