@inherits RazorSlice<ClientKeyTableBodyModel>

<tbody id="@DashboardStyles.ClientKeysTableBodyId">
@foreach (var clientKey in Model.ClientKeys.OrderByDescending(k => k.CreatedAt))
{
    @(await RenderPartialAsync<_Row, ClientKeyRowModel>(new ClientKeyRowModel(clientKey, Model.Error, Model.ErrorEntityId)))
}
</tbody>
