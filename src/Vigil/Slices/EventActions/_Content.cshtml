@inherits RazorSlice<EventActionsIndexModel>

@{
    var openCreateDialogOnclick = $"vigilOpenDialog('{DashboardStyles.CreateEventActionDialogId}')";
}
<div id="@DashboardStyles.EventActionsPageId">
  <div class="@DashboardStyles.DashboardToolbar">
    <h2 class="@DashboardStyles.ToolbarTitle">Event Actions</h2>
    <div class="@DashboardStyles.ToolbarActions">
      <button type="button" class="@DashboardStyles.ButtonWithIcon" onclick="window.location.href='@UiRoutes.EventActions'">@(new HtmlString(DashboardIcons.Reset)) Reset filters</button>
      <button type="button" class="@DashboardStyles.ButtonWithIcon" onclick="@openCreateDialogOnclick">@(new HtmlString(DashboardIcons.Plus)) Create</button>
    </div>
  </div>
  @(await RenderPartialAsync<_Dialog, EventActionDialogModel>(new EventActionDialogModel(DashboardStyles.CreateEventActionDialogId, "New event action", null, Model.Error, Model.KnownGroups)))
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>
            <span class="@DashboardStyles.ThWithFilter">
              Event
              @(await RenderPartialAsync<_ColumnFilter, ColumnFilterModel>(Model.EventFilter))
            </span>
          </th>
          <th>
            <span class="@DashboardStyles.ThWithFilter">
              Type
              @(await RenderPartialAsync<_ColumnFilter, ColumnFilterModel>(Model.TypeFilter))
            </span>
          </th>
          <th>Target</th>
          <th>
            <span class="@DashboardStyles.ThWithFilter">
              Group
              @(await RenderPartialAsync<_ColumnFilter, ColumnFilterModel>(Model.GroupFilter))
            </span>
          </th>
          <th>Priority</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      @(await RenderPartialAsync<_TableBody, IReadOnlyList<EventAction>>(Model.EventActions))
    </table>
  </div>
</div>
