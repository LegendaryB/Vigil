@inherits RazorSlice<EventAction>

@{
    var eventAction = Model;
    var dialogId = DashboardDialogs.DetailsDialogId(eventAction.Id);
    var openDialogOnclick = $"vigilOpenDialog('{dialogId}')";
    var deleteConfirm = $"Delete the '{eventAction.Event.ToDisplayName()}' event action?";

    string TargetType(EventActionTarget target) => target switch
    {
        WebhookTarget => "Webhook",
        CommandTarget => "Command",
        _ => "-"
    };

    string TargetValue(EventActionTarget target) => target switch
    {
        WebhookTarget webhookTarget => webhookTarget.Url,
        CommandTarget commandTarget => commandTarget.Command,
        _ => "-"
    };
}
<tr id="event-action-@eventAction.Id">
  <td>@eventAction.Event.ToDisplayName()</td>
  <td>@TargetType(eventAction.Target)</td>
  <td><code>@TargetValue(eventAction.Target)</code></td>
  <td>@(eventAction.Group ?? "-")</td>
  <td>@eventAction.Priority</td>
  <td>@eventAction.CreatedAt.ToString("u")</td>
  <td>
    <div class="@DashboardStyles.ActionsCell">
      <button type="button" class="@DashboardStyles.IconButton" title="Details" aria-label="Details" onclick="@openDialogOnclick">@(new HtmlString(DashboardIcons.Info))</button>
      @(await RenderPartialAsync<_Dialog, EventActionDialogModel>(new EventActionDialogModel(dialogId, "Event action details", eventAction, null, [])))
      <button class="@DashboardStyles.IconButton" title="Delete" aria-label="Delete"
              hx-post="@UiRoutes.EventActionDelete(eventAction.Id)"
              hx-confirm="@deleteConfirm"
              hx-target="closest tr" hx-swap="delete">@(new HtmlString(DashboardIcons.Trash))</button>
    </div>
  </td>
</tr>
