@inherits RazorSlice<EventActionTableBodyModel>

<tbody id="@DashboardStyles.EventActionsTableBodyId">
@foreach (var eventAction in Model.EventActions.OrderBy(a => a.Event).ThenBy(a => a.Priority))
{
    @(await RenderPartialAsync<_Row, EventActionRowModel>(new EventActionRowModel(eventAction, Model.Error, Model.ErrorEntityId)))
}
</tbody>
