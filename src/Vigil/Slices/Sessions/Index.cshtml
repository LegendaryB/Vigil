@inherits RazorSlice<SessionsIndexModel>
@implements IUsesLayout<_Layout, LayoutModel>

<div class="@DashboardStyles.DashboardToolbar">
  <h2 class="@DashboardStyles.ToolbarTitle">Sessions</h2>
</div>
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>
          <span class="@DashboardStyles.ThWithFilter">
            @(await RenderPartialAsync<_ColumnFilter, ColumnFilterModel>(Model.StatusFilter))
          </span>
        </th>
        <th>Client</th>
        <th>Checked in</th>
        <th>Checked out</th>
        <th>Last seen</th>
        <th>Actions</th>
      </tr>
    </thead>
    @(await RenderPartialAsync<_TableBody, IReadOnlyList<Session>>(Model.Sessions))
  </table>
</div>

@functions {
    public LayoutModel LayoutModel => new("Sessions", true);
}
