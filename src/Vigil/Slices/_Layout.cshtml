@inherits RazorLayoutSlice<LayoutModel>

@{
    var bodyPaddingTop = Model.ShowNav ? "5rem" : "13px";
    var bodyMaxWidth = Model.ShowNav ? "1500px" : "38em";
    var bodyStyle = $"--body-padding-top:{bodyPaddingTop}; --body-max-width:{bodyMaxWidth}";
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@Model.Title - Vigil</title>
  <link rel="stylesheet" href="/sakura.css">
  <link rel="stylesheet" href="/dashboard.css">
  <script src="/htmx.min.js"></script>
  <script>
    function vigilOpenDialog(id) {
      var dialog = document.getElementById(id);
      dialog.showModal();
      dialog.querySelectorAll('[required]').forEach(function (el) {
        el.classList.add('@DashboardStyles.Touched');
      });
    }

    document.addEventListener('htmx:afterSettle', function () {
      var dialog = document.querySelector('dialog[@DashboardStyles.DataReopenAttribute="True"]');
      if (dialog) {
        dialog.removeAttribute('@DashboardStyles.DataReopenAttribute');
        vigilOpenDialog(dialog.id);
      }
    });

    function vigilToggleFilterPopover(id, event) {
      event.stopPropagation();

      var popover = document.getElementById(id);
      var wasOpen = popover.classList.contains('@DashboardStyles.FilterPopoverOpen');

      document.querySelectorAll('.@DashboardStyles.FilterPopover.@DashboardStyles.FilterPopoverOpen').forEach(function (p) {
        p.classList.remove('@DashboardStyles.FilterPopoverOpen');
      });

      if (wasOpen) return;

      var trigger = event.currentTarget;
      var rect = trigger.getBoundingClientRect();
      var width = popover.offsetWidth || 220;
      var left = Math.min(rect.left, window.innerWidth - width - 8);
      left = Math.max(left, 8);

      popover.style.top = (rect.bottom + 4) + 'px';
      popover.style.left = left + 'px';
      popover.classList.add('@DashboardStyles.FilterPopoverOpen');
    }

    function vigilCloseAllFilterPopovers() {
      document.querySelectorAll('.@DashboardStyles.FilterPopover.@DashboardStyles.FilterPopoverOpen').forEach(function (p) {
        p.classList.remove('@DashboardStyles.FilterPopoverOpen');
      });
    }

    document.addEventListener('click', function (event) {
      if (!event.target.closest('.@DashboardStyles.FilterPopover') && !event.target.closest('.@DashboardStyles.ThFilterTrigger')) {
        vigilCloseAllFilterPopovers();
      }
    });

    document.addEventListener('scroll', vigilCloseAllFilterPopovers, true);
    window.addEventListener('resize', vigilCloseAllFilterPopovers);

    function vigilFilterSearch(input, listId) {
      var query = input.value.toLowerCase();
      document.querySelectorAll('#' + listId + ' label').forEach(function (label) {
        label.style.display = label.textContent.toLowerCase().includes(query) ? '' : 'none';
      });
    }

    function vigilFilterOptionBoxes(listId) {
      return document.querySelectorAll('#' + listId + ' input[type=checkbox]:not([data-none-marker])');
    }

    function vigilSyncFilterNoneMarker(listId) {
      var marker = document.querySelector('#' + listId + ' input[data-none-marker]');
      if (!marker) return;

      var anyChecked = Array.prototype.some.call(vigilFilterOptionBoxes(listId), function (cb) { return cb.checked; });
      marker.checked = !anyChecked;
    }

    function vigilFilterSelectAll(checkbox, listId) {
      vigilFilterOptionBoxes(listId).forEach(function (cb) {
        cb.checked = checkbox.checked;
      });
      vigilSyncFilterNoneMarker(listId);
    }

    document.addEventListener('change', function (event) {
      if (event.target.tagName !== 'INPUT' || event.target.type !== 'checkbox' || event.target.hasAttribute('data-none-marker'))
        return;

      var list = event.target.closest('.@DashboardStyles.FilterPopoverList');
      if (list) vigilSyncFilterNoneMarker(list.id);
    });
  </script>
</head>
<body class="dashboard-body" style="@bodyStyle">
  @if (Model.ShowNav)
  {
    <nav class="topbar">
      <div class="topbar-inner">
        <div class="topbar-vigil"><strong>Vigil</strong></div>
        <div class="topbar-links">
          <a href="@UiRoutes.Sessions">Sessions</a>
          <a href="@UiRoutes.ClientKeys">Client Keys</a>
          <a href="@UiRoutes.EventActions">Event Actions</a>
          <a href="@UiRoutes.DispatchLog">Dispatch Log</a>
        </div>
        <div class="topbar-logout">
          <form method="post" action="@UiRoutes.Logout" style="display:inline; margin:0">
            <button type="submit" class="link-button">Logout</button>
          </form>
        </div>
      </div>
    </nav>
  }
  @await RenderBodyAsync()
  <footer class="dashboard-footer">
    <span>&copy; 2026 LegendaryB. All rights reserved.</span>
    <span> | </span>
    <span><a href="https://github.com/LegendaryB/Vigil" target="_blank" rel="noopener noreferrer">GitHub</a></span>
  </footer>
</body>
</html>
