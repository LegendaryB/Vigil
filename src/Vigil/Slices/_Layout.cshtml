@inherits RazorLayoutSlice<LayoutModel>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@Model.Title - Vigil</title>
  <script>
    (function () {
      try {
        var stored = localStorage.getItem('vigil-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch (e) { }
    })();
  </script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/dashboard.css">
  <script src="/htmx.min.js"></script>
  <script>
    function vigilIsDarkTheme() {
      var current = document.documentElement.getAttribute('data-theme');
      return current
        ? current === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
    }

    function vigilSyncThemeToggleIcon() {
      var button = document.querySelector('.@DashboardStyles.ThemeToggle');
      if (!button) return;
      button.innerHTML = vigilIsDarkTheme()
        ? `@(new HtmlString(DashboardIcons.Sun))`
        : `@(new HtmlString(DashboardIcons.Moon))`;
    }

    function vigilToggleTheme() {
      var next = vigilIsDarkTheme() ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('vigil-theme', next); } catch (e) { }
      vigilSyncThemeToggleIcon();
    }

    document.addEventListener('DOMContentLoaded', vigilSyncThemeToggleIcon);

    function vigilOpenDialog(id) {
      var dialog = document.getElementById(id);
      dialog.showModal();
      dialog.querySelectorAll('[required]').forEach(function (el) {
        el.classList.add('@DashboardStyles.Touched');
      });
    }

    document.addEventListener('htmx:afterSettle', function () {
      var dialog = document.querySelector('dialog[@DashboardStyles.DataReopenAttribute="True"]');
      if (dialog) {
        dialog.removeAttribute('@DashboardStyles.DataReopenAttribute');
        vigilOpenDialog(dialog.id);
      }
    });

    function vigilToggleFilterPopover(id, event) {
      event.stopPropagation();

      var popover = document.getElementById(id);
      var wasOpen = popover.classList.contains('@DashboardStyles.FilterPopoverOpen');

      document.querySelectorAll('.@DashboardStyles.FilterPopover.@DashboardStyles.FilterPopoverOpen').forEach(function (p) {
        p.classList.remove('@DashboardStyles.FilterPopoverOpen');
      });

      if (wasOpen) return;

      var trigger = event.currentTarget;
      var rect = trigger.getBoundingClientRect();
      var width = popover.offsetWidth || 220;
      var left = Math.min(rect.left, window.innerWidth - width - 8);
      left = Math.max(left, 8);

      popover.style.top = (rect.bottom + 4) + 'px';
      popover.style.left = left + 'px';
      popover.classList.add('@DashboardStyles.FilterPopoverOpen');
    }

    function vigilCloseAllFilterPopovers() {
      document.querySelectorAll('.@DashboardStyles.FilterPopover.@DashboardStyles.FilterPopoverOpen').forEach(function (p) {
        p.classList.remove('@DashboardStyles.FilterPopoverOpen');
      });
    }

    document.addEventListener('click', function (event) {
      if (!event.target.closest('.@DashboardStyles.FilterPopover') && !event.target.closest('.@DashboardStyles.ThFilterTrigger')) {
        vigilCloseAllFilterPopovers();
      }
    });

    document.addEventListener('scroll', vigilCloseAllFilterPopovers, true);
    window.addEventListener('resize', vigilCloseAllFilterPopovers);

    function vigilFilterSearch(input, listId) {
      var query = input.value.toLowerCase();
      document.querySelectorAll('#' + listId + ' label').forEach(function (label) {
        label.style.display = label.textContent.toLowerCase().includes(query) ? '' : 'none';
      });
    }

    function vigilFilterOptionBoxes(listId) {
      return document.querySelectorAll('#' + listId + ' input[type=checkbox]:not([data-none-marker])');
    }

    function vigilSyncFilterNoneMarker(listId) {
      var marker = document.querySelector('#' + listId + ' input[data-none-marker]');
      if (!marker) return;

      var anyChecked = Array.prototype.some.call(vigilFilterOptionBoxes(listId), function (cb) { return cb.checked; });
      marker.checked = !anyChecked;
    }

    function vigilFilterSelectAll(checkbox, listId) {
      vigilFilterOptionBoxes(listId).forEach(function (cb) {
        cb.checked = checkbox.checked;
      });
      vigilSyncFilterNoneMarker(listId);
    }

    document.addEventListener('change', function (event) {
      if (event.target.tagName !== 'INPUT' || event.target.type !== 'checkbox' || event.target.hasAttribute('data-none-marker'))
        return;

      var list = event.target.closest('.@DashboardStyles.FilterPopoverList');
      if (list) vigilSyncFilterNoneMarker(list.id);
    });
  </script>
</head>
<body>
  @if (Model.ShowNav)
  {
    <div class="@DashboardStyles.App">
      <aside class="@DashboardStyles.Sidebar">
        <div class="@DashboardStyles.Brand">
          @(new HtmlString(DashboardIcons.Logo))
          <strong>Vigil</strong>
        </div>
        <div class="@DashboardStyles.NavLabel">Menu</div>
        <nav>
          <a class="@DashboardStyles.NavLink @(Model.ActivePage == DashboardPage.Sessions ? DashboardStyles.NavLinkActive : "")" href="@UiRoutes.Sessions">
            @(new HtmlString(DashboardIcons.NavSessions))
            <span>Sessions</span>
          </a>
          <a class="@DashboardStyles.NavLink @(Model.ActivePage == DashboardPage.ClientKeys ? DashboardStyles.NavLinkActive : "")" href="@UiRoutes.ClientKeys">
            @(new HtmlString(DashboardIcons.NavClientKeys))
            <span>Client Keys</span>
          </a>
          <a class="@DashboardStyles.NavLink @(Model.ActivePage == DashboardPage.EventActions ? DashboardStyles.NavLinkActive : "")" href="@UiRoutes.EventActions">
            @(new HtmlString(DashboardIcons.NavEventActions))
            <span>Event Actions</span>
          </a>
          <a class="@DashboardStyles.NavLink @(Model.ActivePage == DashboardPage.DispatchLog ? DashboardStyles.NavLinkActive : "")" href="@UiRoutes.DispatchLog">
            @(new HtmlString(DashboardIcons.NavDispatchLog))
            <span>Dispatch Log</span>
          </a>
        </nav>
        <div class="sidebar-meta">
          <a href="https://github.com/LegendaryB/Vigil" target="_blank" rel="noopener noreferrer">GitHub</a>
          <span>&copy; 2026 LegendaryB</span>
        </div>
        <div class="@DashboardStyles.SidebarFoot">
          <form method="post" action="@UiRoutes.Logout" style="display:inline; margin:0">
            <button type="submit" class="link-button">Logout</button>
          </form>
          <button type="button" class="@DashboardStyles.ThemeToggle" onclick="vigilToggleTheme()" title="Toggle theme" aria-label="Toggle theme">
            @(new HtmlString(DashboardIcons.Sun))
          </button>
        </div>
      </aside>
      <main>
        @await RenderBodyAsync()
      </main>
    </div>
  }
  else
  {
    @await RenderBodyAsync()
  }
</body>
</html>
